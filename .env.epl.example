# EPL Challenge frontend (branch epl-promo-frontend). Copy to .env.local / .env.production
# on the EPL host and fill in. Placeholders only - never commit real values.
# All NEXT_PUBLIC_* values are baked into the client bundle at build time: put nothing
# secret in them.

# --- EPL promo ---
# Which promo this build serves (EPL, REGULAR_SEASON, PRESEASON). Default EPL.
NEXT_PUBLIC_ACTIVE_PROMO=EPL
# true = promo-only build: / and every main-app route redirect to /promo
# (required for the international EPL deployment: the real-money app must not be exposed).
NEXT_PUBLIC_PROMO_ONLY=true
# Public site origin, used for og:url / og:image links (no trailing slash).
NEXT_PUBLIC_SITE_URL=https://<epl-site-domain>
# Backend (epl-promo-backend) origin, without /api/v1.
NEXT_PUBLIC_API_BASE_URL=https://<epl-backend-domain>

# --- Coinbase CDP embedded wallet (email sign-in; users get EOAs) ---
NEXT_PUBLIC_CDP_PROJECT_ID=<cdp-project-id>

# --- Main Str8Up app (unused when NEXT_PUBLIC_PROMO_ONLY=true; the build still reads them) ---
NEXT_PUBLIC_IMAGE_URL=<image-base-url>
NEXT_PUBLIC_BASE_RPC_URL=<base-rpc-url>
NEXT_PUBLIC_CHAIN_ID=8453
NEXT_PUBLIC_PREDICTION_CONTRACT_ADDRESS=<prediction-contract-address>
NEXT_PUBLIC_TOKEN_CONTRACT_ADDRESS=<str8-token-address>
NEXT_PUBLIC_GAS_FEE=<gas-fee>
